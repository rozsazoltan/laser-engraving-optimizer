{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "engraving",
  "version": "0.1.0",
  "identifier": "com.rozsazoltan.engraving",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "cwd": "ui",
      "script": "pnpm dev --port 5173 --strictPort"
    },
    "beforeBuildCommand": {
      "cwd": "ui",
      "script": "pnpm build"
    }
  },
  "app": {
    "windows": [
      {
        "title": "engraving",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
